---
// Eigener kurzer Clip, der stumm und in Schleife von selbst abspielt.
// Gibt es die Datei (noch) nicht, wird ein animierter Platzhalter gezeigt.
import { existsSync } from 'node:fs';
import { UI, langFromPath } from '../i18n';
const t = UI[langFromPath(Astro.url.pathname)];
interface Props { src: string; label?: string }
const { src, label = 'Dein Clip' } = Astro.props;
const hasVideo = existsSync(`public${src}`);
---
<div class="reel">
  {hasVideo ? (
    <video src={src} autoplay muted loop playsinline preload="metadata"></video>
  ) : (
    <div class="reel-fallback" aria-hidden="true">
      <div class="sun"></div>
      <svg class="reel-waves" viewBox="0 0 400 120" preserveAspectRatio="none"><path d="M0 60 Q50 30 100 60 T200 60 T300 60 T400 60 V120 H0Z" /></svg>
      <span class="reel-label">{label}<br /><small>{t.reelHint} public{src}</small></span>
    </div>
  )}
</div>
