---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Reel from '../components/Reel.astro';
import Photo from '../components/Photo.astro';
import Marquee from '../components/Marquee.astro';
import Faq from '../components/Faq.astro';
import CodeTicket from '../components/CodeTicket.astro';
import BuyButton from '../components/BuyButton.astro';
import { SITE, VIDEOS, HERO_VIDEO } from '../config';
import { langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const p = lang === 'en' ? '/en' : '';
const C = {
  de: {
    label: 'Au-pair Tahiti · Volunteering Hawaii',
    h1: 'Ein Jahr im Pazifik. <em>Ohne Agentur.</em>',
    lead: `Ich bin ${SITE.author}. Ich war als Au-pair auf Tahiti und als Volunteer auf Hawaii, beide Male ohne Agentur. Hier schreibe ich alles auf, was ich vorher gerne gewusst hätte.`,
    toGuide: 'Zum Guide',
    watch: 'Erstmal gratis lesen',
    heroMedia: 'Dein Lieblingsfoto oder Clip',
    heroCaption: 'Tahiti, Französisch-Polynesien',
    whereTitle: 'Zwei Inseln, <em>zwei Wege</em>',
    tahitiTitle: 'Au-pair auf Tahiti',
    tahitiText: 'Gastfamilie ohne Agentur finden, Einreise, Versicherung und was das Leben in Französisch-Polynesien wirklich kostet.',
    tahitiPhoto: 'Foto aus Tahiti',
    hawaiiTitle: 'Volunteering auf Hawaii',
    hawaiiText: 'Mit Worldpackers gratis wohnen, die richtigen Hosts finden und mit meinem Code bei der Mitgliedschaft sparen.',
    hawaiiPhoto: 'Foto aus Hawaii',
    read: 'Artikel lesen',
    faqLabel: 'Häufige Fragen',
    faqTitle: 'Was ich jeden Tag <em>in meinen DMs</em> lese',
    videosLabel: 'TikTok und Instagram',
    videosTitle: 'Lieber schauen <em>statt lesen?</em>',
    moreTiktok: 'Mehr auf TikTok',
    followInsta: 'Instagram',
    aboutLabel: 'Über mich',
    aboutTitle: `Hi, ich bin <em>${SITE.author}</em>`,
    aboutPhoto: 'Foto von dir',
    aboutText: 'Mein Gap Year hat mich nach Tahiti und Hawaii gebracht, und seitdem bekomme ich jeden Tag die gleichen Fragen. Statt jede DM einzeln zu beantworten, sammle ich hier alles an einem Ort.',
    aboutTodo: 'Ein paar Sätze in deinen eigenen Worten: Gap Year 2024/25, zweiter Aufenthalt 2026, was dich am meisten überrascht hat.',
    guideLabel: 'Der Guide',
    guideTitle: 'Der Blog sagt dir, <em>dass</em> es geht. Der Guide zeigt dir, <em>wie</em>.',
    guideText: 'Meine Vorlagen für Profil und erste Nachricht, die Gruppen, in denen ich gesucht habe, eine echte Kostenaufstellung, Checklisten für Einreise und Versicherung und ein Plan B, falls es nicht passt.',
    whatsInside: 'Was drin ist',
    blogLabel: 'Blog',
    blogTitle: 'Neu im <em>Blog</em>',
  },
  en: {
    label: 'Au pair Tahiti · Volunteering Hawaii',
    h1: 'A year in the Pacific. <em>No agency.</em>',
    lead: `I'm ${SITE.author}. I was an au pair in Tahiti and a volunteer in Hawaii, both times without an agency. Here I write down everything I wish I'd known before.`,
    toGuide: 'Get the guide',
    watch: 'Read for free first',
    heroMedia: 'Your favourite photo or clip',
    heroCaption: 'Tahiti, French Polynesia',
    whereTitle: 'Two islands, <em>two ways</em>',
    tahitiTitle: 'Au pair in Tahiti',
    tahitiText: 'Find a host family without an agency, sort out entry and insurance, and see what life in French Polynesia really costs.',
    tahitiPhoto: 'Photo from Tahiti',
    hawaiiTitle: 'Volunteering in Hawaii',
    hawaiiText: 'Stay for free with Worldpackers, find the right hosts and save on your membership with my code.',
    hawaiiPhoto: 'Photo from Hawaii',
    read: 'Read the article',
    faqLabel: 'FAQ',
    faqTitle: 'What I read <em>in my DMs</em> every day',
    videosLabel: 'TikTok and Instagram',
    videosTitle: 'Rather watch <em>than read?</em>',
    moreTiktok: 'More on TikTok',
    followInsta: 'Instagram',
    aboutLabel: 'About me',
    aboutTitle: `Hi, I'm <em>${SITE.author}</em>`,
    aboutPhoto: 'Photo of you',
    aboutText: 'My gap year took me to Tahiti and Hawaii, and ever since I get the same questions every day. Instead of answering every DM one by one, I collect everything here.',
    aboutTodo: 'A few sentences in your own words, in English.',
    guideLabel: 'The guide',
    guideTitle: 'The blog tells you <em>that</em> it works. The guide shows you <em>how</em>.',
    guideText: 'My templates for your profile and first message, the groups where I searched, a real cost breakdown, checklists for entry and insurance, and a plan B in case it does not work out.',
    whatsInside: "What's inside",
    blogLabel: 'Blog',
    blogTitle: 'New on the <em>blog</em>',
  },
}[lang];
const tahitiPost = lang === 'en' ? '/en/blog/au-pair-tahiti-without-agency/' : '/blog/au-pair-tahiti-ohne-agentur/';
const hawaiiPost = `${p}/blog/volunteering-hawaii-worldpackers/`;
---
<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="label">{C.label}</p>
      <h1 set:html={C.h1} />
      <p class="lead">{C.lead}</p>
      <div class="actions">
        <a class="btn" href={`${p}/guide/`}>{C.toGuide}</a>
        <a class="link-arrow" href={`${p}/blog/`}>{C.watch}</a>
      </div>
    </div>
    <figure class="hero-media">
      <Reel src={HERO_VIDEO} label={C.heroMedia} />
      <figcaption>{C.heroCaption} <span>17°32′S 149°34′W</span></figcaption>
    </figure>
  </section>

  <Marquee />

  <section class="wrap section">
    <h2 class="section-title" set:html={C.whereTitle} />
    <div class="split">
      <a class="destination" href={tahitiPost}>
        <Photo alt={C.tahitiPhoto} ratio="3 / 2" />
        <span class="destination-no">01</span>
        <h3>{C.tahitiTitle}</h3>
        <p>{C.tahitiText}</p>
        <span class="link-arrow">{C.read}</span>
      </a>
      <a class="destination" href={hawaiiPost}>
        <Photo alt={C.hawaiiPhoto} ratio="3 / 2" />
        <span class="destination-no">02</span>
        <h3>{C.hawaiiTitle}</h3>
        <p>{C.hawaiiText}</p>
        <span class="link-arrow">{C.read}</span>
      </a>
    </div>
  </section>

  <section class="wrap section faq-section">
    <div>
      <p class="label">{C.faqLabel}</p>
      <h2 class="section-title" set:html={C.faqTitle} />
    </div>
    <Faq />
  </section>

  <section class="videos" id="videos">
    <div class="wrap">
      <p class="label">{C.videosLabel}</p>
      <h2 class="section-title" set:html={C.videosTitle} />
      <div class="video-wall">
        {VIDEOS.map((v) => <VideoEmbed url={v.url} caption={v.caption[lang]} />)}
      </div>
      <div class="actions">
        <a class="btn btn-light" href={SITE.socials.tiktok}>{C.moreTiktok}</a>
        <a class="link-arrow light" href={SITE.socials.instagram}>{C.followInsta}</a>
      </div>
    </div>
  </section>

  <section class="wrap section about">
    <Photo alt={C.aboutPhoto} />
    <div>
      <p class="label">{C.aboutLabel}</p>
      <h2 class="section-title" set:html={C.aboutTitle} />
      <p class="lead-dark">{C.aboutText}</p>
      <div class="todo">{C.aboutTodo}</div>
    </div>
  </section>

  <section class="guide-band">
    <div class="wrap guide-band-inner">
      <div>
        <p class="label">{C.guideLabel} · {SITE.price}</p>
        <h2 class="section-title" set:html={C.guideTitle} />
      </div>
      <div>
        <p>{C.guideText}</p>
        <div class="actions">
          <BuyButton />
          <a class="link-arrow" href={`${p}/guide/`}>{C.whatsInside}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title" set:html={C.blogTitle} />
    <PostList limit={3} />
  </section>

  <section class="wrap section-tight">
    <CodeTicket />
  </section>
</Base>
